# Local Hardhat node only. The backend refuses any host other than localhost / 127.0.0.1.
# Writes are signed by the node's unlocked accounts (#0 = owner by default); no private key is configured.
RPC_URL=http://127.0.0.1:8545
PORT=3001
# Comma-separated frontend origins.
CORS_ORIGIN=http://localhost:30141,https://thanh-30141.motcaigido.xyz
# Optional: where deployed addresses are saved (default backend/deployment.json).
# DEPLOYMENT_FILE=

